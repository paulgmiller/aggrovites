<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/invitation.css" rel="stylesheet">
    <title>{{ .title }}</title>
    <script>
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "nl9q05t0mc");
    </script>
</head>
<body>
<main class="container invitation-editor">
    <h1>{{ .headerText }}</h1>
    {{if .error}}<p class="alert alert-warning" role="alert">{{.error}}</p>{{end}}
    <form action="{{.createAction}}" method="post" data-progress="Creating your invitation. Artwork may take a couple of minutes…">
        <div class="mb-3">
            <label for="Description" class="form-label">What's the occasion? Include any links and location.</label>
            <textarea id="Description" name="Description" rows="7" class="form-control" maxlength="12000" required>{{with .input}}{{.Description}}{{end}}</textarea>
        </div>
        <div class="mb-3">
            <label for="Start" class="form-label">When?</label>
            <input type="datetime-local" id="Start" name="Start" class="form-control" required value="{{with .input}}{{if not .Start.IsZero}}{{.Start.Format "2006-01-02T15:04"}}{{end}}{{end}}">
            <input type="hidden" id="TimeZone" name="TimeZone" value="{{with .input}}{{.TimeZone}}{{end}}">
        </div>
        {{if .aiEnabled}}
        <button type="submit" name="Generate" value="true" class="btn btn-success">Create invitation</button>
        <button type="submit" name="Generate" value="false" class="btn btn-outline-secondary">Create without AI</button>
        {{else}}
        <p>Create your invitation, then share its link when you're happy with it.</p>
        <button type="submit" name="Generate" value="false" class="btn btn-success">Create invitation</button>
        {{end}}
        <p data-progress-message role="status" class="mt-3" hidden></p>
    </form>
</main>
<script src="/assets/invitation.js" defer></script>
</body>
</html>
