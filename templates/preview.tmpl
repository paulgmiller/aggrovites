<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/invitation.css" rel="stylesheet">
    <title>Review your invitation</title>
</head>
<body>
<main class="container invitation-editor">
    <h1>Review your invitation</h1>
    <p>Happy with it? Publish below. To make changes, use your browser's back button and edit the details.</p>
    {{if .draft.Notice}}<p class="alert alert-warning" role="alert">{{.draft.Notice}}</p>{{end}}
    {{if .draft.Image}}<img class="event-artwork" src="{{.imageURL}}" alt="Event illustration" width="512" height="512">{{end}}
    <article class="invitation-content">{{.preview}}</article>
    <p>{{.draft.Start.Format "Mon, Jan 2, 2006 at 3:04 PM"}} ({{.draft.TimeZone}})</p>
    <form action="{{.publishAction}}" method="post" data-progress="Publishing your invitation…">
        <input type="hidden" name="DraftToken" value="{{.draft.Token}}">
        {{if .draft.Image}}
        <div class="form-check my-3">
            <input type="checkbox" id="IncludeImage" name="IncludeImage" value="true" class="form-check-input" checked>
            <label for="IncludeImage" class="form-check-label">Publish with illustration</label>
        </div>
        {{end}}
        <button type="submit" class="btn btn-success">Publish invitation</button>
        <p data-progress-message role="status" class="mt-3" hidden></p>
    </form>
    <p class="mt-3">Your RSVP form will appear on the published page. This private preview expires after 24 hours.</p>
</main>
<script src="/assets/invitation.js" defer></script>
</body>
</html>
